# PostgreSQL connection used by Drizzle and the API server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# The API service workflow supplies PORT and BASE_PATH in Replit.
NODE_ENV=development
PORT=8080
BASE_PATH=/api
LOG_LEVEL=info

# Set in Replit Secrets for protected catalog administration.
# Production startup requires at least 24 characters.
MARAJE3_ADMIN_TOKEN=

# Comma-separated exact browser origins, for example https://app.example.com.
# Empty means all origins in development and no browser origins in production.
CORS_ORIGINS=

# The mobile dev/build workflows normally inject this value.
EXPO_PUBLIC_DOMAIN=your-replit-domain

# Contributor accounts (Google sign-in). Server-side.
# Comma-separated Google OAuth Client IDs this server accepts as audiences —
# one per platform (Android, iOS, Web) from Google Cloud Console.
GOOGLE_CLIENT_IDS=
# Random long secret used to sign contributor session JWTs.
# Production startup requires at least 32 characters.
SESSION_SECRET=

# Contributor accounts (Google sign-in). Mobile app, build-time (EXPO_PUBLIC_*
# values are bundled into the app, not secret). From the same Google Cloud
# Console OAuth clients as GOOGLE_CLIENT_IDS above.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Student uploads: storage backend. Pick one: "r2" or "replit".
# Uploads return 503 until this and the matching block below are set.
STORAGE_DRIVER=

# --- STORAGE_DRIVER=r2 (Cloudflare R2, S3-compatible) ---
# True presigned uploads: the app PUTs bytes directly to the bucket.
# R2_PUBLIC_BASE_URL must serve the bucket publicly (R2 public bucket URL or
# a custom domain in front of it) — it's what materials.documentUrl is built
# from, so it must be reachable by anyone without extra auth.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- STORAGE_DRIVER=replit (Replit Object Storage) ---
# @replit/object-storage has no presigned-URL capability, so uploads and
# downloads are both relayed through this server instead of going straight
# to the bucket. PUBLIC_SERVER_URL is this API server's own public origin
# (e.g. https://your-repl-domain.replit.app, no trailing slash, no /api) —
# used to build the absolute download URL stored in materials.documentUrl.
# REPLIT_BUCKET_ID is optional; omit it to use the Repl's default bucket.
PUBLIC_SERVER_URL=
REPLIT_BUCKET_ID=

# Upload limits (all optional; defaults shown).
MAX_UPLOAD_BYTES=26214400
UPLOAD_DAILY_QUOTA=10
UPLOAD_SUSPENSION_STRIKE_THRESHOLD=3
UPLOAD_SUSPENSION_DAYS=7

# Stage 4 — recognition/titles, leaderboard, free-Premium grant (all
# optional; defaults shown). Thresholds count published materials only.
RESCUER_TITLE_MATERIALS_THRESHOLD=10
RESCUER_TITLE_DOWNLOADS_THRESHOLD=500
PREMIUM_GRANT_MATERIALS_THRESHOLD=5
PREMIUM_GRANT_DOWNLOADS_THRESHOLD=100
# There's no start/end date on a semester in this catalog, so the
# leaderboard's "semester" scope approximates it as a trailing window of
# download activity instead of a real semester boundary.
LEADERBOARD_WINDOW_DAYS=120

# Stage 6 — share links (/m/:id page). The public domain this API server is
# reached at (no trailing slash, no /api) — same host the app already talks
# to. Used to build the absolute https://<PUBLIC_BASE_URL>/m/<id> link a
# student shares, and in the page's OpenGraph og:url tag. If unset, the
# share page itself still works (relative links), just without an absolute
# URL to copy/share.
PUBLIC_BASE_URL=

# Optional — shown as a "حمّل تطبيق مراجعي" fallback button on the /m/:id
# share page for someone who doesn't have the app yet (a Play Store/App
# Store link once published). Leave unset to hide that button.
PUBLIC_STORE_URL=

# Stage 6 — Telegram bot bridge (artifacts/telegram-bot, grammY). The bot
# process needs its own TELEGRAM_BOT_TOKEN (from @BotFather) to talk to
# Telegram, and both the bot and this API server need the same
# BOT_API_SECRET — it authenticates the bot's calls to this server's
# internal endpoints (POST /internal/submissions, POST
# /internal/telegram/link). Submissions/linking return 503 until both are
# set. Generate BOT_API_SECRET yourself (e.g. `openssl rand -hex 32`); it is
# not a value Replit or Telegram issues.
TELEGRAM_BOT_TOKEN=
BOT_API_SECRET=
# This API server's own base URL, so the bot process (a separate deployment)
# knows where to send its internal calls. Usually the same value as
# PUBLIC_BASE_URL above.
MARAJE3_API_BASE_URL=

# Stage 7 — Premium one-time purchase, server-side verification (routes/premium.ts).
# A Google Cloud service account JSON key (as a single-line string, from the
# Google Play Console → Setup → API access → linked GCP project → create a
# service account with "View financial data" + release permissions, then
# grant it access in Play Console) — pasted here, NOT a file path. Purchase
# verification returns 503 until both this and ANDROID_PACKAGE_NAME are set.
# NOT exercised against real Google Play credentials in this environment —
# see the Stage 7 report.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Must match artifacts/maraje3/app.json's android.package (currently
# edu.maraje3.studentlibrary).
ANDROID_PACKAGE_NAME=edu.maraje3.studentlibrary

# Stage 7 — AdMob (react-native-google-mobile-ads). Needs a Google-approved
# AdMob account + app registration; until then the test IDs below (Google's
# own published sample units) keep the app buildable. These are read at
# Expo *prebuild* time (artifacts/maraje3/app.config.js), not at runtime —
# changing them requires a fresh native build, not just a server restart.
# Read by app.config.js at Expo *prebuild* time (plain Node process.env —
# no EXPO_PUBLIC_ prefix needed, this never runs in the client bundle).
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
# Read at runtime by lib/ads.ts (artifacts/maraje3) — these DO need the
# EXPO_PUBLIC_ prefix since Expo inlines only EXPO_PUBLIC_* vars into the
# client JS bundle.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_IOS=ca-app-pub-3940256099942544/1712485313

# Stage 7 — Premium product id as configured in Google Play Console (the
# in-app non-consumable product's SKU). Read by the client (react-native-iap)
# to start a purchase, and sent back to POST /premium/verify-purchase.
EXPO_PUBLIC_PREMIUM_PRODUCT_ID=maraje3_premium_lifetime

# Stage 8 — Google Play policy compliance. A real inbox you'll actually
# check, shown on /privacy, /terms, /delete-account, /takedown (routes/
# pages.ts). Optional — each page still works without it (it just omits the
# contact/email section), but Play Console's data-safety form expects a
# working contact channel, so set this before submitting for review.
PUBLIC_CONTACT_EMAIL=
# Same address, read at build time by the app's "About" screen
# (app/about.tsx) — needs the EXPO_PUBLIC_ prefix to be inlined into the
# client bundle. Keep identical to PUBLIC_CONTACT_EMAIL above.
EXPO_PUBLIC_CONTACT_EMAIL=
